# Template for .env.production - copy to .env.production and fill in real values.
# The real file is gitignored. Never commit real values: this repository is public.

# .env.production
NODE_ENV=production

# Ethereum
RPC_URL=<REPLACE_ME>
PRIVATE_KEY=<REPLACE_ME>
TREASURY_ADDRESS=<REPLACE_ME>
ARB_EXECUTOR_ADDRESS=<REPLACE_ME>

# Database
DATABASE_URL=<REPLACE_ME>

# API
PORT_BACKEND=3002
PORT_BOT=3001
PORT=3000

# Security
JWT_SECRET=<REPLACE_ME>
SESSION_SECRET=<REPLACE_ME>

# External APIs
COINGECKO_API=<REPLACE_ME>
ETHERSCAN_API_KEY=<REPLACE_ME>

# Monitoring & Observability
SENTRY_DSN=<REPLACE_ME>
LOGTAIL_TOKEN=<REPLACE_ME>

# Logging
LOG_LEVEL=info

# Bot Configuration
MIN_PROFIT_ETH=0.01
MAX_GAS_GWEI=50
MIN_PROFIT_THRESHOLD=0.005
SCAN_INTERVAL_MS=200

# Risk Management
MAX_SLIPPAGE_PERCENT=1.0
MAX_GAS_PRICE_GWEI=100
MIN_LIQUIDITY_ETH=10

# Private Relay (Optional)
PRIVATE_RELAY_URL=<REPLACE_ME>

# Frontend
NEXT_PUBLIC_API_URL=<REPLACE_ME>
NEXT_PUBLIC_WS_URL=<REPLACE_ME>
