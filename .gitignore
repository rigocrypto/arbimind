node_modules
.next
dist
.vercel
package-lock.json
*.log
logs/
.env
.env.*

# Sensitive local credential dump files (never commit)
packages/ui/src/app/settings/Bugcrowd Org (Set 4) httpsbugcrowd-.txt
.env.local
.env*.local
*-credentials*.env
testnet-credentials-NEW.env
pnpm-debug.log*

# Foundry/Forge submodule artifacts (untracked after cleanup)
.gitmodules
packages/contracts/lib/forge-std
packages/contracts/lib/openzeppelin-contracts
packages/contracts/lib/v3-core
packages/contracts/lib/v3-periphery

# Foundry/Forge build output (regenerated by `forge build` / the test suite)
/packages/contracts/cache/
/packages/contracts/out/

packages/backend/.env
packages/ui/.env.local

# Keep example templates tracked. These negations must follow every .env
# ignore rule above: gitignore is last-match-wins, so placing them earlier
# would leave the templates ignored. Without them `.env.*` also swallows
# `.env.production.example`.
!.env.example
!.env.*.example
!packages/*/.env.example
!packages/*/.env.*.example

# TypeScript incremental build info -- generated by tsc, never committed.
# Surfaced when ui type-check switched from `next build` to `tsc --noEmit`.
*.tsbuildinfo

runtime_probe.txt

# Local working artifacts
.codex-worktrees/
packages/bot/coverage/
.keep-local/

# Shadow-run snapshots: runtime artifacts, regenerated by each shadow run.
shadow-*.json
packages/bot/shadow-*.json
